{
  // "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "2d_shoot",
  "main": "src/index.js",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
